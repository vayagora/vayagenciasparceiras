# Supabase › Project Settings › API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave secreta (service_role): só no servidor. Usada para convidar usuários.
SUPABASE_SERVICE_ROLE_KEY=
# Endereço público do sistema (ex.: https://parceiros.vayagora.com.br)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# HubSpot (app privado): escopos crm.objects.contacts.read/write, crm.objects.deals.read, crm.schemas.deals.write
HUBSPOT_TOKEN=
# Etapa(s) do funil que contam como venda concluída (135525686 = "Emissão Realizada"), separadas por vírgula
HUBSPOT_WON_STAGES=135525686
# Rótulo de associação que marca o titular do negócio
HUBSPOT_TITULAR_LABEL=Titular
# Nome interno do campo do negócio com a agência parceira (lista suspensa; opção = nome do parceiro no sistema)
HUBSPOT_PROP_AFILIADO=agencia_parceira
# Senha da sincronização agendada (/api/cron/sync). A Vercel envia automaticamente.
CRON_SECRET=
