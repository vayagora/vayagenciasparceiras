# Supabase › Project Settings › API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave secreta (service_role): só no servidor. Usada para convidar usuários.
SUPABASE_SERVICE_ROLE_KEY=
# Endereço público do sistema (ex.: https://parceiros.vayagora.com.br)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# HubSpot (app privado): escopos de leitura crm.objects.deals.read, crm.objects.contacts.read, crm.objects.companies.read
HUBSPOT_TOKEN=
# Etapa(s) do funil que contam como venda concluída (135525686 = "Emissão Realizada"), separadas por vírgula
HUBSPOT_WON_STAGES=135525686
# Rótulos de associação negócio → contato: titular (um ou mais, separados por vírgula), comprador e passageiro
HUBSPOT_TITULAR_LABEL=Titular,Comprador
HUBSPOT_BUYER_LABEL=Comprador
HUBSPOT_PASSENGER_LABEL=Passageiro
# Negócio de agência parceira: "Origem do Negócio" = "Afiliado" e a agência associada como Empresa.
# O nome da empresa no HubSpot precisa ser igual ao nome do parceiro no sistema (ex.: JT Viajar e Correr).
HUBSPOT_ORIGEM_PROP=origem_do_negocio
# Valores aceitos (o primeiro é o sugerido ao corrigir)
HUBSPOT_ORIGEM_VALUE=Agência Parceira,Afiliado
# Etapas "antes da compra" (cliente em negociação)
HUBSPOT_OPEN_STAGES=appointmentscheduled,qualifiedtobuy,presentationscheduled,135850329,contractsent,135525685
HUBSPOT_LOST_STAGES=closedlost
# Campo do NEGÓCIO com as observações que o parceiro vê
HUBSPOT_PROP_OBS_PARCEIRO=observacoes_para_parceiro
# ID da conta HubSpot (links para os negócios)
HUBSPOT_PORTAL_ID=44656712
# Senha da sincronização agendada (/api/cron/sync). A Vercel envia automaticamente.
CRON_SECRET=
