# Supabase › Project Settings › API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave secreta (service_role): só no servidor. Usada para convidar usuários.
SUPABASE_SERVICE_ROLE_KEY=
# Endereço público do sistema (ex.: https://parceiros.vayagora.com.br)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# HubSpot (app privado): escopos crm.objects.contacts.read/write, crm.objects.deals.read, crm.schemas.deals.write
HUBSPOT_TOKEN=
# Estágio(s) "ganho" do funil, separados por vírgula
HUBSPOT_WON_STAGES=closedwon
# Rótulo de associação que marca o titular do negócio
HUBSPOT_TITULAR_LABEL=Titular
# Nomes internos das propriedades do negócio
HUBSPOT_PROP_AFILIADO=afiliado
HUBSPOT_PROP_ROTEIRO=roteiro
HUBSPOT_PROP_DATA_VOLTA=data_volta
HUBSPOT_PROP_VALOR_VOO=valor_voo
HUBSPOT_PROP_VALOR_HOSPEDAGEM=valor_hospedagem
HUBSPOT_PROP_VALOR_SEGURO=valor_seguro
# Senha da sincronização agendada (/api/cron/sync). A Vercel envia automaticamente.
CRON_SECRET=
